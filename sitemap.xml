---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.pages | where_exp: "item", "item.sitemap != false" %}
{% for item in pages %}
  {% if item.url and item.url != "/404.html" %}<url><loc>{{ item.url | absolute_url }}</loc></url>{% endif %}
{% endfor %}
{% for item in site.labs %}<url><loc>{{ item.url | absolute_url }}</loc><lastmod>{{ item.updated | default: item.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
{% for item in site.writing %}<url><loc>{{ item.url | absolute_url }}</loc><lastmod>{{ item.updated | default: item.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
{% for item in site.projects %}<url><loc>{{ item.url | absolute_url }}</loc><lastmod>{{ item.updated | default: item.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
</urlset>
